# =============================================================================
# MCP server instance — env template (metadata_db)
#
# Copy this to `.env` beside it (an instance's env file is always
# `instances/<instance>/.env`), fill in the values, and launch the server with
# it — the flag is REQUIRED, there is no default instance:
#     uv run mcp-db-server --env-file instances/metadata_db/.env
# The real `.env` files are gitignored (they hold the role password + auth
# tokens); only this `.env.example` is committed.
#
# Each instance connects as its OWN dedicated read-only Postgres role, scoped by
# the role's grants (CONNECT to its database(s); USAGE + SELECT on the schemas).
# The served-database set is derived from those grants, not configured here.
#
# metadata_db is a structured metadata catalog (data dictionary) with NO
# embedding tables -- see the `search` note under models below.
# =============================================================================

# --- connection (the scoped read-only role) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mcp_ro_metadata       # a NON-superuser role: CONNECT to metadata_db only, USAGE + SELECT on public, no INSERT/UPDATE/DELETE
POSTGRES_PASSWORD=<the role password>
POSTGRES_DB=metadata_db             # home DB (also the catalog-introspection bootstrap)

# --- this instance's identity / bind ---
MCP_INSTANCE_NAME=metadata_db
MCP_HOST=127.0.0.1                   # bind localhost; a TLS reverse proxy fronts it for network use
MCP_PORT=8002                        # policy_db uses 8000; give each instance its own port (8001 is taken by the client application)
# MCP_ALLOWED_HOSTS=                  # Host-header allowlist for the transport's DNS-rebinding
#                                     # protection. Leave UNSET for a loopback bind or when a
#                                     # reverse proxy rewrites Host to localhost (the default
#                                     # deployment). Only needed when MCP_HOST is non-loopback and
#                                     # clients connect directly by hostname/IP: their request
#                                     # carries Host: <that address>, which the SDK's localhost-only
#                                     # default rejects (HTTP 421). Comma-separated exact hosts or
#                                     # host:* port wildcards, e.g. 10.0.0.5:*,localhost:* ; set "*"
#                                     # to disable rebinding protection entirely.
# MCP_ALLOWED_ORIGINS=               # companion Origin allowlist (same format); only consulted when
#                                     # MCP_ALLOWED_HOSTS names explicit hosts. Non-browser clients
#                                     # send no Origin and are allowed regardless.
# Orientation shown to the connecting agent (MCP initialize). Defaults to a
# generic discover-then-query prompt; override to describe THIS instance's domain:
# MCP_INSTRUCTIONS=Read-only access to metadata_db: a metadata catalog (data dictionary) describing other databases — systems, data_sources, schemas, tables, columns, table_relationships, and column-level lineage (column_mappings), each mirrored by a *_hstry temporal-history table, plus ddl_versions/load_audit load tracking. Discover with list_databases -> list_schemas -> list_tables -> describe_tables (columns + PK + foreign-key references = the join graph). This instance has NO embeddings: use run_sql for precise read-only SQL; the search tool has no targets. All access is strictly read-only.

# --- models ---
# metadata_db has NO embedding tables, so the `search` tool has nothing to hit
# (it returns a clean "No embedding tables found" error). The other five tools
# -- list_databases, list_schemas, list_tables, describe_table, run_sql -- are
# fully functional. Therefore:
MCP_WARM_MODELS=false                # skip startup embedding/reranker warm-up: unused here, and it saves the load
# MCP_EMBEDDING_MODEL=              # irrelevant for this instance (no embeddings); defaults to granite if search is ever called
# MCP_RERANK_MODEL=BAAI/bge-reranker-base   # default; unused here (no search)
# MCP_TRUST_REMOTE_CODE=false   # default false (no model-shipped code runs on load)

# --- auth: one bearer token per user (label:token, comma-separated) ---
MCP_AUTH_TOKENS=alice:<token>,bob:<token>
#
# Client connection: the committed `.mcp.json` references ${MCP_METADATA_DB_TOKEN}
# and never holds a token. Each user, one time, sets their OWN token then restarts
# Claude Code:
#   macOS/Linux (zsh/bash) or Git Bash on Windows -- add to ~/.zshrc or ~/.bashrc:
#       export MCP_METADATA_DB_TOKEN="<their token>"
#   Windows PowerShell -- set a persistent user env var (run once):
#       [Environment]::SetEnvironmentVariable("MCP_METADATA_DB_TOKEN","<their token>","User")
#       (current session only:  $env:MCP_METADATA_DB_TOKEN="<their token>" )
# Onboard a user: append another  label:token  pair above and restart the server.
# Revoke: remove their pair and restart. Generate a token with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Tokenless access (opt-out): set MCP_DISABLE_AUTH=true to serve /mcp with NO
# auth -- every request is accepted and MCP_AUTH_TOKENS is ignored. This exposes
# the DB tools (run_sql) to anyone who can reach the port. Note the port stays
# network-reachable behind the TLS reverse proxy this server is meant to run
# behind or on a shared host, so a 127.0.0.1 bind is NOT by itself protection --
# auth is REQUIRED for that deployment. Enable this only on a genuinely isolated
# box (a personal dev machine with no proxy). Default (unset) keeps bearer auth on.
# MCP_DISABLE_AUTH=false

# --- optional tuning overrides (defaults shown) ---
# MCP_MAX_ROWS=500
# MCP_STATEMENT_TIMEOUT_S=5
# MCP_RERANK_POOL=50
# MCP_RERANK_GLOBAL_POOL=50      # cap on the merged cross-schema candidate pool
#                                # sent to the reranker (unused here; no search)
# MCP_DB_POOL_SIZE=5
# MCP_DB_MAX_OVERFLOW=10
# MCP_HNSW_EF_SEARCH=100
# MCP_LOG_LEVEL=INFO
