# =============================================================================
# MCP server instance — env template (policy_db)
#
# Copy this to `.env` beside it (an instance's env file is always
# `instances/<instance>/.env`), fill in the values, and launch the server with
# it — the flag is REQUIRED, there is no default instance:
#     uv run mcp-db-server --env-file instances/policy_db/.env
# The real `.env` files are gitignored (they hold the role password + auth
# tokens); only this `.env.example` is committed.
#
# Each instance connects as its OWN dedicated read-only Postgres role, scoped by
# the role's grants (CONNECT to its database(s); USAGE + SELECT on the schemas).
# The served-database set is derived from those grants, not configured here.
# =============================================================================

# --- connection (the scoped read-only role) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mcp_ro_policy          # a NON-superuser role: CONNECT to POSTGRES_DB only, USAGE + SELECT on its schemas, no INSERT/UPDATE/DELETE
POSTGRES_PASSWORD=<the role password>
POSTGRES_DB=policy_db                # home DB (also the catalog-introspection bootstrap)

# --- this instance's identity / bind ---
MCP_INSTANCE_NAME=policy_db
MCP_HOST=127.0.0.1                   # bind localhost; a TLS reverse proxy fronts it for network use
MCP_PORT=8000
# MCP_ALLOWED_HOSTS=                  # Host-header allowlist for the transport's DNS-rebinding
#                                     # protection. Leave UNSET for a loopback bind or when a
#                                     # reverse proxy rewrites Host to localhost (the default
#                                     # deployment). Only needed when MCP_HOST is non-loopback and
#                                     # clients connect directly by hostname/IP: their request
#                                     # carries Host: <that address>, which the SDK's localhost-only
#                                     # default rejects (HTTP 421). Comma-separated exact hosts or
#                                     # host:* port wildcards, e.g. 10.0.0.5:*,localhost:* ; set "*"
#                                     # to disable rebinding protection entirely.
# MCP_ALLOWED_ORIGINS=               # companion Origin allowlist (same format); only consulted when
#                                     # MCP_ALLOWED_HOSTS names explicit hosts. Non-browser clients
#                                     # send no Origin and are allowed regardless.
# Orientation shown to the connecting agent (MCP initialize). Defaults to a
# generic discover-then-query prompt; override to describe THIS instance's domain:
# MCP_INSTRUCTIONS=Read-only access to policy_db: CMS Internet-Only Manuals (cms_iom), QPP cost-measure codes/forms (qpp_cm), and select US Code titles (usc). Use list_databases->...->describe_tables, then search or run_sql. Read-only.

# --- models ---
MCP_EMBEDDING_MODEL=ibm-granite/granite-embedding-small-english-r2   # MUST match the model that built the embeddings
# MCP_RERANK_MODEL=BAAI/bge-reranker-base   # default; override only to change the reranker (quality, not correctness)
# MCP_TRUST_REMOTE_CODE=false   # default false (no model-shipped code runs on load);
#                               set true ONLY for a custom-architecture model that needs it

# --- auth: one bearer token per user (label:token, comma-separated) ---
MCP_AUTH_TOKENS=alice:<token>,bob:<token>
#
# Client connection: the committed `.mcp.json` references ${MCP_POLICY_DB_TOKEN}
# and never holds a token. Each user, one time, sets their OWN token then restarts
# Claude Code:
#   macOS/Linux (zsh/bash) or Git Bash on Windows -- add to ~/.zshrc or ~/.bashrc:
#       export MCP_POLICY_DB_TOKEN="<their token>"
#   Windows PowerShell -- set a persistent user env var (run once):
#       [Environment]::SetEnvironmentVariable("MCP_POLICY_DB_TOKEN","<their token>","User")
#       (current session only:  $env:MCP_POLICY_DB_TOKEN="<their token>" )
# Onboard a user: append another  label:token  pair above and restart the server.
# Revoke: remove their pair and restart. Generate a token with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Tokenless access (opt-out): set MCP_DISABLE_AUTH=true to serve /mcp with NO
# auth -- every request is accepted and MCP_AUTH_TOKENS is ignored. This exposes
# the DB tools (run_sql, search) to anyone who can reach the port. Note the port
# stays network-reachable behind the TLS reverse proxy this server is meant to
# run behind (see docs/activities/mcp-server/modernize-rag-mcp-server.md) or on a
# shared host, so a 127.0.0.1 bind is NOT by itself protection -- auth is
# REQUIRED for that deployment. Enable this only on a genuinely isolated box (a
# personal dev machine with no proxy). Default (unset) keeps bearer auth on.
# MCP_DISABLE_AUTH=false

# --- optional tuning overrides (defaults shown) ---
# MCP_MAX_ROWS=500
# MCP_STATEMENT_TIMEOUT_S=5
# MCP_RERANK_POOL=50
# MCP_RERANK_GLOBAL_POOL=50      # cap on the merged cross-schema candidate pool
#                                # sent to the reranker (default: MCP_RERANK_POOL,
#                                # raised to top_k when larger). Bounds rerank cost
#                                # so multi-schema search latency stays close to a
#                                # single-schema call; lower it to trade a little
#                                # recall for faster reranking.
# MCP_DB_POOL_SIZE=5
# MCP_DB_MAX_OVERFLOW=10
# MCP_HNSW_EF_SEARCH=100
# MCP_LOG_LEVEL=INFO
# MCP_WARM_MODELS=true          # warm embedding+reranker at startup so the first
#                               search isn't a cold start; false skips (dev)
